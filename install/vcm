#!/usr/bin/env bash
# vcm — run VideoCaptionMaker.
#
#   vcm start       start the app and open it in the browser
#   vcm stop        stop it (your videos stay)
#   vcm restart     stop, then start
#   vcm status      what is running, and whether it is healthy
#   vcm logs [svc]  follow the logs (all services, or e.g. `vcm logs worker`)
#   vcm update      download the newest version and restart into it
#   vcm open        open the app in the browser
#   vcm uninstall   remove the app; asks before deleting your videos
#   vcm doctor      write a report to attach to a bug report (secrets left out)
set -euo pipefail

VCM_HOME="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
REPO_URL="https://github.com/Tanush1206/Video-Caption-Maker"
BASE_URL="${VCM_BASE_URL:-$REPO_URL/releases/latest/download}"
PROJECT=vcm
# Where vcm was run from, before it moves into its own folder (vcm doctor
# writes its report there).
START_DIR="$PWD"
cd "$VCM_HOME"

env_value() { grep "^$1=" .env 2>/dev/null | cut -d= -f2- || true; }
PORT="$(env_value VCM_PORT)"; PORT="${PORT:-3000}"
URL="http://localhost:$PORT"

# COMPOSE_SUFFIX=.tmp: the files an update has staged, not the installed ones.
compose() {
    local files=(-f "docker-compose.prod.yml${COMPOSE_SUFFIX:-}")
    [ "$(env_value VCM_VARIANT)" = "cuda" ] && files+=(-f "docker-compose.gpu.yml${COMPOSE_SUFFIX:-}")
    docker compose -p "$PROJECT" --env-file .env "${files[@]}" "$@"
}

# Antivirus that scans HTTPS breaks a few of Docker's TLS handshakes to
# GitHub's registry (v1.3.1): with Quick Heal's scanning on, 5 in 120 from
# Docker failed with "tls: error decoding message", none with it off and
# none from the computer itself. A pull keeps the layers it already has, so
# trying again fetches only what failed.
PULL_TRIES=3
TLS_TROUBLE='tls: |x509|certificate|decoding message|bad record mac'
DROPPED='i/o timeout|connection reset|unexpected eof'

pull() {
    local log try=1
    log="$(mktemp)"
    until compose pull 2>&1 | tee "$log"; do
        if [ $try -ge $PULL_TRIES ] || ! grep -qiE "$TLS_TROUBLE|$DROPPED" "$log"; then
            if grep -qiE "$TLS_TROUBLE" "$log"; then
                {
                    echo
                    echo "Couldn't download the images: the secure connection to GitHub's image registry kept failing."
                    echo "This is usually antivirus software that scans HTTPS traffic (for example Quick Heal)."
                    echo "To fix it, either:"
                    echo "  - turn off its HTTPS (web) scanning while this runs, then turn it back on; or"
                    echo "  - add an exception for ghcr.io and pkg-containers.githubusercontent.com."
                    echo "Then try again. Nothing was changed."
                } >&2
            fi
            rm -f "$log"
            return 1
        fi
        try=$((try + 1))
        echo "The download was interrupted; trying again ($try of $PULL_TRIES)..." >&2
        sleep "${VCM_PULL_WAIT:-5}"
    done
    rm -f "$log"
}

# `vcm update` (v1.4.0) hands the update over to the version it has just
# downloaded and checked, so what an update says and does is the new
# version's own. The new one first answers `__handover` with this token,
# then runs `__finish-update`; if it can't start, or exits 3 (stopped before
# changing anything), the running version finishes the update itself.
HANDOVER="vcm-handover-1"
UPDATE_FILES="docker-compose.prod.yml docker-compose.gpu.yml vcm"

# An ARM install made before v1.4.0 runs the Intel/AMD images, emulated;
# its first update to native images downloads them in full.
switching_to_arm() {
    local image
    case "$(docker version --format '{{.Server.Arch}}' 2>/dev/null)" in arm64|aarch64) ;; *) return 1 ;; esac
    image="$(docker inspect --format '{{.Image}}' "$PROJECT-backend-1" 2>/dev/null)" || return 1
    [ "$(docker image inspect --format '{{.Architecture}}' "$image" 2>/dev/null)" = amd64 ]
}

# The files staged as *.tmp (checked against SHA256SUMS) put to use: pulled
# with first and moved into place only after, so a download that fails
# leaves the install exactly as it was.
finish_update() {
    if switching_to_arm; then
        echo "This update moves the app to native ARM images, so it downloads them in full"
        echo "once (about 1 GB). Updates after this one are small again."
    fi
    if ! COMPOSE_SUFFIX=.tmp pull; then
        rm -f ./*.tmp
        echo "The update stopped before changing anything: the app is still on the version you had." >&2
        return 1
    fi
    for file in $UPDATE_FILES; do mv "$file.tmp" "$file"; done
    rm -f SHA256SUMS.tmp
    chmod +x vcm
    compose up -d --remove-orphans
    wait_ready
    # Only this app's old images (the ones the update just replaced, now
    # untagged), never anything else on the machine.
    docker image prune -f --filter "label=org.opencontainers.image.source=https://github.com/Tanush1206/Video-Caption-Maker" >/dev/null 2>&1 || true
    echo "Updated."
}

# `vcm doctor` (v1.4.0): what a bug report needs, in one file to attach.
# Never the .env (only VCM_VERSION, VCM_VARIANT and VCM_PORT are read from it),
# and everything written passes through `redact`: tokens, keys, email
# addresses, video file names and your home folder are taken out.
# Portable sed (macOS has BSD sed: no I flag, no \b), so cases are spelled out.
VIDEO_EXT='([Mm][Pp]4|[Mm][Oo][Vv]|[Mm][Kk][Vv]|[Ww][Ee][Bb][Mm]|[Aa][Vv][Ii]|[Mm]4[Vv]|[Ss][Rr][Tt]|[Vv][Tt][Tt])'
redact() {
    sed -E \
        -e 's/([Tt]oken|[Pp]assword|[Ss]ecret|[Kk]ey)=[^&" ]*/\1=<redacted>/g' \
        -e 's/([Aa]uthorization|[Cc]ookie|[Ss]et-[Cc]ookie):[^"]*/\1: <redacted>/g' \
        -e 's/AIza[0-9A-Za-z_-]{20,}/<redacted key>/g' \
        -e 's/eyJ[0-9A-Za-z_-]{10,}\.[0-9A-Za-z_-]+\.[0-9A-Za-z_-]+/<redacted token>/g' \
        -e 's/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/<email>/g' \
        -e "s/\"[^\"]*\\.$VIDEO_EXT\"/\"<video>\"/g" \
        -e "s/'[^']*\\.$VIDEO_EXT'/'<video>'/g" \
        -e "s/[^ \"\\/]+\\.$VIDEO_EXT([^A-Za-z0-9]|\$)/<video>\\2/g" \
        -e 's/"vocabulary": ?\[[^]]*\]/"vocabulary": "<redacted>"/g' \
        -e 's/ \(UUID: [^)]*\)//g' \
        -e "s#${HOME:-/nonexistent}#~#g"
}

# The version that is running (v1.4.1): the app's own answer, or the backend
# image's label when the app isn't answering. An install's .env usually says
# VCM_VERSION=latest, which tells a bug report nothing.
running_version() {
    local version
    version="$(curl -fsS -m 10 "$URL/api/system" 2>/dev/null | grep -o '"version": *"[^"]*"' | head -n 1 | cut -d'"' -f4)" || true
    if [ -n "$version" ]; then echo "$version"; return; fi
    version="$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$PROJECT-backend-1" 2>/dev/null | head -n 1)" || true
    if [ -n "$version" ]; then echo "$version, from the image: the app isn't answering"
    else echo "unknown: the app isn't answering and its image wasn't found"; fi
}

doctor() {
    local out
    out="$START_DIR/vcm-doctor-$(date +%Y-%m-%d-%H%M%S).txt"
    section() { echo; echo "== $1"; }
    {
        echo "VideoCaptionMaker doctor report, $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "Version: $(running_version) (VCM_VERSION=$(env_value VCM_VERSION) in .env)"
        section "App (from .env: these three keys only)"
        for key in VCM_VERSION VCM_VARIANT VCM_PORT; do echo "$key=$(env_value "$key")"; done
        section "System"
        uname -srm 2>/dev/null
        [ -f /etc/os-release ] && grep -E '^(PRETTY_NAME)=' /etc/os-release
        command -v sw_vers >/dev/null 2>&1 && sw_vers 2>/dev/null
        df -h "$VCM_HOME" 2>/dev/null | tail -n 1 | awk '{print "disk free: "$4" of "$2}'
        section "Docker"
        docker version --format 'docker {{.Server.Version}} on {{.Server.Os}}/{{.Server.Arch}}' 2>&1
        docker compose version 2>&1
        docker info --format 'CPUs {{.NCPU}}, memory {{.MemTotal}} bytes, {{.OperatingSystem}}' 2>&1
        section "GPU"
        if command -v nvidia-smi >/dev/null 2>&1; then
            nvidia-smi -L 2>&1
            nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>&1
        else
            echo "no nvidia-smi"
        fi
        section "Containers"
        compose ps -a 2>&1
        for c in $(compose ps -aq 2>/dev/null); do
            docker inspect --format '{{.Name}} {{.Config.Image}} {{.Image}}' "$c" 2>&1
        done
        section "Health"
        curl -fsS -m 10 "$URL/api/health" 2>&1; echo
        section "System info (/api/system)"
        curl -fsS -m 10 "$URL/api/system" 2>&1; echo
        section "Logs (the last 300 lines of each service)"
        compose logs --no-color --tail 300 2>&1
    } | redact > "$out"
    echo "Wrote $out"
    echo "Review it before attaching it to a bug report: secrets, file names and"
    echo "your home folder are taken out, but you know best what is private."
}

need_docker() {
    docker info >/dev/null 2>&1 || {
        echo "Docker isn't running. Start Docker (Docker Desktop, or: sudo systemctl start docker) and try again." >&2
        exit 1
    }
}

open_browser() {
    if [ "$(uname -s)" = "Darwin" ]; then open "$URL" >/dev/null 2>&1 || true
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1 || true
    else echo "Open $URL in your browser."; fi
}

wait_ready() {
    printf 'Waiting for the app'
    for _ in $(seq 1 120); do
        if curl -fsS "$URL/api/health" >/dev/null 2>&1; then echo " — ready at $URL"; return 0; fi
        printf '.'; sleep 3
    done
    echo; echo "Not answering yet. Check: vcm status / vcm logs" >&2; return 1
}

confirm() {  # reads from the terminal even when stdin is a pipe
    local answer
    printf '%s ' "$1" > /dev/tty
    read -r answer < /dev/tty || answer=""
    [ "$answer" = "$2" ]
}

cmd="${1:-help}"; shift || true
case "$cmd" in
    start)    need_docker; compose up -d; wait_ready && open_browser ;;
    up)       need_docker; compose up -d ;;
    pull)     need_docker; pull ;;
    stop)     need_docker; compose stop; echo "Stopped. Your videos are kept; 'vcm start' brings it back." ;;
    restart)  need_docker; compose stop; compose up -d; wait_ready ;;
    status)   need_docker; compose ps -a ;;
    logs)     need_docker; compose logs -f --tail 200 "$@" ;;
    open)     open_browser ;;
    update)
        need_docker
        echo "Fetching the latest version…"
        # All downloaded and checked against SHA256SUMS before any is replaced.
        for file in $UPDATE_FILES SHA256SUMS; do
            curl -fsSL --retry 3 "$BASE_URL/$file" -o "$file.tmp" \
                || { rm -f ./*.tmp; echo "Couldn't download $file; nothing was changed." >&2; exit 1; }
        done
        for file in $UPDATE_FILES; do
            expected="$(awk -v f="$file" '$2 == f || $2 == "*"f { print $1 }' SHA256SUMS.tmp)"
            if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$file.tmp" | cut -d' ' -f1)"
            else actual="$(shasum -a 256 "$file.tmp" | cut -d' ' -f1)"; fi
            [ -n "$expected" ] && [ "$actual" = "$expected" ] \
                || { rm -f ./*.tmp; echo "$file didn't match the release's SHA256SUMS; nothing was changed." >&2; exit 1; }
        done
        if [ "$(bash ./vcm.tmp __handover 2>/dev/null)" = "$HANDOVER" ]; then
            status=0
            bash ./vcm.tmp __finish-update || status=$?
            [ "$status" -ne 3 ] && exit "$status"
            echo "The new version couldn't finish the update; this one will." >&2
        fi
        finish_update
        ;;
    __handover) echo "$HANDOVER" ;;
    __finish-update)
        # Run by the previous version, the new files staged as *.tmp. Exit 3:
        # nothing done yet, so the previous version can finish instead.
        docker info >/dev/null 2>&1 || exit 3
        for file in $UPDATE_FILES SHA256SUMS; do [ -f "$file.tmp" ] || exit 3; done
        finish_update
        ;;
    uninstall)
        need_docker
        echo "This removes VideoCaptionMaker from this computer."
        deleted=0
        # Asked before anything stops: `down -v` only removes the anonymous
        # volumes (redis /data) of containers it is removing in the same call.
        if confirm "Also delete ALL your videos, captions and downloaded models? This cannot be undone. Type DELETE to confirm, or press Enter to keep them:" "DELETE"; then
            compose down --remove-orphans -v
            deleted=1
            echo "Deleted your data."
        else
            compose down --remove-orphans
            echo "Kept your data (Docker volumes named vcm_*). Reinstalling picks it up again."
        fi
        # Only this app's own images. postgres, redis and chroma are shared base
        # images that other projects on this machine may be using.
        compose config --images 2>/dev/null | grep '/video-caption-maker-' | sort -u \
            | while read -r image; do docker image rm "$image" >/dev/null 2>&1 || true; done
        rm -f "$HOME/.local/bin/vcm"
        cd /
        # Never a directory this script did not install into.
        if [ "$deleted" = 1 ] && [ -f "$VCM_HOME/docker-compose.prod.yml" ] \
            && [ "$VCM_HOME" != "$HOME" ] && [ "$VCM_HOME" != "/" ]; then
            rm -rf "$VCM_HOME"
        else
            # .env holds the database password the kept data is locked with.
            echo "Kept $VCM_HOME too: it holds the password for your kept data."
        fi
        echo "Uninstalled."
        ;;
    doctor)   doctor ;;
    help|-h|--help|*)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        ;;
esac
