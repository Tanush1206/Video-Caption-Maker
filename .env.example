# ── Database ─────────────────────────────────────────────
POSTGRES_USER=vcm
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=vcm

# ── Redis / Celery ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── ChromaDB ─────────────────────────────────────────────
CHROMADB_URL=http://chromadb:8000

# ── Auth / Security ──────────────────────────────────────
# local = single user, no login (the installed app). accounts = hosted mode.
AUTH_MODE=local
# 64 hex characters, as the installer generates: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_64_hex_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── LLM Provider (Gemini) — optional ─────────────────────
# Translation runs locally without it. A Gemini key is pasted into Settings in
# the app, never written to a .env file.
GEMINI_MODEL=gemini-flash-latest

# ── Whisper / Transcription ──────────────────────────────
# "auto" picks from the hardware (see backend/app/services/hardware.py).
WHISPER_MODEL_SIZE=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# ── Storage ───────────────────────────────────────────────
STORAGE_LOCAL_PATH=/app/storage

# ── Dev image ────────────────────────────────────────────
# cpu builds the CPU image (default). cuda builds the CUDA image; use it with
# -f docker-compose.gpu.yml so the worker gets the GPU.
VCM_VARIANT=cpu

# ── App ──────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=2048
